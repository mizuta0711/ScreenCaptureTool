<Window x:Class="ScreenCaptureTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ScreenCaptureTool.Windows.Controls"
        mc:Ignorable="d"
        Title="画面キャプチャーツール"
        Height="450"
        Width="800">
    <Grid>
        <!-- メニューバーの追加 -->
        <Menu VerticalAlignment="Top">
            <MenuItem Header="ファイル (_F)">
                <MenuItem Header="開く (_O)"
                        Click="OnOpenProjectMenu_Clicked" />
                <MenuItem Header="上書き保存 (_S)"
                        Click="OnSaveProjectMenu_Clicked" />
                <MenuItem Header="名前を付けて保存 (_A)"
                        Click="OnSaveAsProjectMenu_Clicked" />
                <Separator />
                <MenuItem Header="終了 (_X)"
                        Click="OnExitMenu_Clicked" />
            </MenuItem>
            <MenuItem Header="表示 (_D)">
                <MenuItem x:Name="ThumbnailSizeMenu" Header="サムネイルサイズ">
                    <MenuItem Header="特大" IsCheckable="True" Click="ThumbnailSizeMenuItem_Click" Tag="200" />
                    <MenuItem Header="大" IsCheckable="True" Click="ThumbnailSizeMenuItem_Click" Tag="150" />
                    <MenuItem Header="中" IsCheckable="True" Click="ThumbnailSizeMenuItem_Click" Tag="100" />
                    <MenuItem Header="小" IsCheckable="True" Click="ThumbnailSizeMenuItem_Click" Tag="50" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="0, 20, 0, 0">
            <Grid.RowDefinitions>
                <!-- 上部の設定エリア -->
                <RowDefinition Height="Auto" />
                <!-- 下部のサムネイル表示エリア -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 上部の設定UI -->
            <StackPanel Grid.Row="0"
                        Height="150"
                        Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <ListView Height="150"
                                  ItemsSource="{Binding RecordingSettings}"
                                  SelectionChanged="SettingListView_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="100" />
                                    <GridViewColumn Header="タイプ" DisplayMemberBinding="{Binding Type}" Width="100" />
                                    <GridViewColumn Header="保存方法" DisplayMemberBinding="{Binding SaveType}" Width="100" />
                                    <GridViewColumn Header="説明" DisplayMemberBinding="{Binding Description}" Width="200" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>

                    <StackPanel>
                        <!-- 撮影ボタン -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="10,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <Button x:Name="buttonAddSetting"
                                        Content="追加"
                                        Width="70"
                                        Height="25"
                                        Click="AddSettingButton_Click"
                                        Margin="0,0,0,0" />
                                <Button x:Name="buttonEditSetting"
                                        Content="編集"
                                        Width="70"
                                        Height="25"
                                        Click="EditSettingButton_Click"
                                        Margin="0,5,0,0" />
                            </StackPanel>
                            <Button x:Name="buttonCapture"
                                    Content="撮影"
                                    Width="100"
                                    Height="100"
                                    Click="CaptureButton_Click"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 下部のサムネイル表示エリア -->
            <Grid Grid.Row="1">
                <!-- 左右のペインを分割 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="5" />
                    <!-- GridSplitter のスペース -->
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- 左側のフォルダツリー表示 -->
                <controls:FolderTreeView x:Name="FolderTreeView"
                        Grid.Column="0"
                        SelectedItemChanged="FolderTreeView_SelectedItemChanged" />

                <!-- GridSplitter：左右のペインの幅をドラッグで変更可能にする -->
                <GridSplitter Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Gray"
                        ShowsPreview="True" />

                <!-- 右側のサムネイル表示エリア -->
                <ScrollViewer Grid.Column="2"
                        VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ThumbnailItemsControl"
                            ItemsSource="{Binding ImageFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- WrapPanelを使用して上寄せで表示 -->
                                <WrapPanel VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <Border BorderThickness="2"
                                            CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Background" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="Blue" />
                                                        <Setter Property="Background" Value="#DCE6F1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Thumbnail}"
                                               Width="{Binding ThumbnailWidth}"
                                               Height="{Binding ThumbnailHeight}"
                                               Stretch="Uniform"
                                               MouseLeftButtonDown="Thumbnail_MouseLeftButtonDown">
                                            <Image.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="削除"
                                                        Click="DeleteMenuItem_Click" />
                                                </ContextMenu>
                                            </Image.ContextMenu>
                                        </Image>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>