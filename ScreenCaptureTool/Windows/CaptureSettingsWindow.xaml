<Window x:Class="ScreenCaptureTool.Windows.CaptureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenCaptureTool.Windows.Controls"
        Title="撮影設定"
        Height="455"
        Width="460"
        WindowStartupLocation="CenterOwner">
    <StackPanel Orientation="Vertical"
            Margin="10">
        <!-- 設定名称 -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="名称"
                    HorizontalAlignment="Left"
                    Height="16"
                    VerticalAlignment="Top"
                    Width="36"/>
            <TextBox x:Name="textBoxName"
                    Width="395"
                    Height="16"
                    TextWrapping="Wrap"
                    Text=""
                    VerticalAlignment="Top"/>
        </StackPanel>

        <!-- 撮影方法 -->
        <TextBlock Text="撮影方法"
                HorizontalAlignment="Left"
                Height="16"
                VerticalAlignment="Top"
                Width="53"
                Margin="0,10,0,0"/>

        <!-- 撮影方法：ウィンドウ全体 -->
        <StackPanel Orientation="Vertical"
                VerticalAlignment="Top"
                Margin="20,5,10,0"
                Height="40">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="radioButtonWindow"
                        Content="ウィンドウ全体"
                        GroupName="RecordingType"
                             Height="14"
                        HorizontalAlignment="Left"
                             Checked="RecordingType_CheckedChanged"/>
                <TextBlock Text="※ウィンドウタイトルを指定してウィンドウ全体を撮影します"
                        FontSize="9"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="RecordingTypeWindowPanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="20,10,0,0">
                <!-- ウィンドウタイトル -->
                <TextBlock x:Name="labelWindowTitle"
                        Text="ウィンドウタイトル"
                        HorizontalAlignment="Left"
                        Height="16"
                        VerticalAlignment="Center"
                        Width="82"/>
                <TextBox x:Name="textBoxWindowTitle"
                        Height="16"
                        TextWrapping="Wrap"
                        Text=""
                        VerticalAlignment="Center"
                        Width="300"/>
            </StackPanel>
        </StackPanel>

        <!-- 撮影方法：画面の一部 -->
        <StackPanel Orientation="Vertical"
                VerticalAlignment="Top"
                Margin="20,10,10,0"
                Height="120">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="radioButtonRectangle"
                        Content="画面の一部"
                        GroupName="RecordingType"
                             Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                             Checked="RecordingType_CheckedChanged"/>
                <TextBlock Text="※画面内の一部を撮影します。位置、サイズを固定しない場合は撮影時に指定します"
                        FontSize="9"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="RecordingTypeRectanglePanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="20,10,0,0">
                <StackPanel Orientation="Vertical"
                        Width="400"
                        Height="85">
                    <!-- 位置 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="labelWindowRectPos"
                                Text="位置"
                                HorizontalAlignment="Left"
                                Height="16"
                                VerticalAlignment="Top"
                                Width="50"/>
                        <CheckBox x:Name="checkBoxFixedPos"
                                Content="固定"
                                HorizontalAlignment="Left"
                                Height="14"
                                Width="80"
                                VerticalAlignment="Top"
                                Click="FixedPositionCheckBox_Clicked"/>
                        <StackPanel x:Name="recordingPositionPanel"
                                Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="labelWindowPosX"
                                        Text="X座標："
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        Width="50"/>
                                <controls:NumericTextBox x:Name="textBoxWindowPosX"
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        TextWrapping="Wrap"
                                        Text=""
                                        VerticalAlignment="Top"
                                        Width="50"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,5,0,0">
                                <TextBlock x:Name="labelWindowPosY"
                                        Text="Y座標："
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        Width="50"/>
                                <controls:NumericTextBox x:Name="textBoxWindowPosY"
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        TextWrapping="Wrap"
                                        Text=""
                                        VerticalAlignment="Top"
                                        Width="50"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- サイズ -->
                    <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0">
                        <TextBlock x:Name="labelWindowRectSize"
                                Text="サイズ"
                                HorizontalAlignment="Left"
                                Height="16"
                                VerticalAlignment="Top"
                                Width="50"/>
                        <CheckBox x:Name="checkBoxFixedSize"
                                Content="固定"
                                HorizontalAlignment="Left"
                                Height="14"
                                Width="80"
                                VerticalAlignment="Top"
                                Click="FixedSizeCheckBox_Clicked"/>
                        <StackPanel x:Name="recordingSizePanel"
                                Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="labelWindowWidth"
                                        Text="幅："
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        Width="50"/>
                                <controls:NumericTextBox x:Name="textBoxWindowWidth"
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        TextWrapping="Wrap"
                                        Text=""
                                        VerticalAlignment="Top"
                                        Width="50"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,5,0,0">
                                <TextBlock x:Name="labelWindowHeight"
                                        Text="高さ："
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        Width="50"/>
                                <controls:NumericTextBox x:Name="textBoxWindowHeight"
                                        HorizontalAlignment="Left"
                                        Height="16"
                                        TextWrapping="Wrap"
                                        Text=""
                                        VerticalAlignment="Top"
                                        Width="50"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 画像加工 -->
        <StackPanel Orientation="Horizontal"
                VerticalAlignment="Top"
                Margin="10,10,10,0"
                Height="90">
            <TextBlock Text="画像加工"
                    HorizontalAlignment="Left"
                    Height="16"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top"
                    Width="63"/>
            <!-- 画像加工：縁カット -->
            <StackPanel Orientation="Vertical">
                <CheckBox x:Name="checkBoxTrimEdge"
                        Content="縁カット"
                        HorizontalAlignment="Left"
                        Height="14"
                        VerticalAlignment="Top"
                        Click="TrimEdgesCheckBox_Clicked"/>
                <StackPanel x:Name="trimEdgesPanel"
                        Orientation="Vertical"
                        Margin="20,10,0,0">
                    <controls:NumericTextBox x:Name="textBoxTrimTop"
                            HorizontalAlignment="Center"
                            Height="16"
                            TextWrapping="Wrap"
                            Text="0"
                            VerticalAlignment="Top"
                            Width="50"/>
                    <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">
                        <controls:NumericTextBox x:Name="textBoxTrimLeft"
                                HorizontalAlignment="Left"
                                Height="16"
                                TextWrapping="Wrap"
                                Text="0"
                                VerticalAlignment="Top"
                                Width="50"/>
                        <controls:NumericTextBox x:Name="textBoxTrimRight"
                                HorizontalAlignment="Right"
                                Height="16"
                                TextWrapping="Wrap"
                                Text="0"
                                VerticalAlignment="Top"
                                Margin="10,0,0,0"
                                Width="50"/>
                    </StackPanel>
                    <controls:NumericTextBox x:Name="textBoxTrimBottom"
                            HorizontalAlignment="Center"
                            Height="16"
                            TextWrapping="Wrap"
                            Text="0"
                            VerticalAlignment="Top"
                            Margin="0,5,0,0"
                            Width="50"/>
                </StackPanel>
            </StackPanel>
            <!-- 画像加工：リサイズ -->
            <StackPanel Orientation="Vertical"
                    Margin="20,0,0,0">
                <CheckBox x:Name="checkBoxResize"
                        Content="リサイズ"
                        HorizontalAlignment="Left"
                        Height="14"
                        VerticalAlignment="Top"
                        Click="ResizeCheckBox_Clicked"/>
                <StackPanel x:Name="resizePanel"
                        Orientation="Vertical"
                        Margin="10,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="labelResizeWidth"
                                Text="幅："
                                HorizontalAlignment="Left"
                                Height="16"
                                VerticalAlignment="Top"
                                Width="50"/>
                        <controls:NumericTextBox x:Name="textBoxResizeWidth"
                                HorizontalAlignment="Left"
                                Height="16"
                                TextWrapping="Wrap"
                                Text=""
                                VerticalAlignment="Top"
                                Width="50"/>
                        <TextBlock Text="px"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">
                        <TextBlock x:Name="labelResizeHeight"
                                Text="高さ："
                                HorizontalAlignment="Left"
                                Height="16"
                                VerticalAlignment="Top"
                                Width="50"/>
                        <controls:NumericTextBox x:Name="textBoxResizeHeight"
                                HorizontalAlignment="Left"
                                Height="16"
                                TextWrapping="Wrap"
                                Text=""
                                VerticalAlignment="Top"
                                Width="50"/>
                        <TextBlock Text="px"/>
                    </StackPanel>
                    <TextBlock Text="※アスペクト比が異なる場合も強制的にリサイズされます"
                            FontSize="9"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 保存方法 -->
        <StackPanel Orientation="Horizontal"
                Margin="10,10,10,0"
                Height="35">
            <TextBlock Text="保存方法"
                    HorizontalAlignment="Left"
                    Height="16"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top"
                    Width="70"/>
            <StackPanel Orientation="Vertical"
                    Width="120">
                <RadioButton x:Name="radioButtonSaveClipboard"
                        Content="クリップボード"
                        GroupName="SaveTo"
                        HorizontalAlignment="Left"
                        Height="14"
                        VerticalAlignment="Top"/>
                <RadioButton x:Name="radioButtonSaveBMP"
                        Content="ファイル(BMP形式)"
                        GroupName="SaveTo"
                        HorizontalAlignment="Left"
                        Height="14"
                        Margin="0,5,0,0"
                        VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                    Width="120">
                <RadioButton x:Name="radioButtonSavePNG"
                        Content="ファイル(PNG形式)"
                        GroupName="SaveTo"
                        HorizontalAlignment="Left"
                        Height="14"
                        VerticalAlignment="Top"/>
                <RadioButton x:Name="radioButtonSaveJPEG"
                        Content="ファイル(JPEG形式)"
                        GroupName="SaveTo"
                        HorizontalAlignment="Left"
                        Height="14"
                        Margin="0,5,0,0"
                        VerticalAlignment="Top"/>
            </StackPanel>
        </StackPanel>

        <!-- OK/キャンセルボタン -->
        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10,0,10"
                Height="25"
                VerticalAlignment="Bottom">
            <Button Content="OK"
                    Width="75"
                    Margin="0,0,20,0"
                    Click="OkButton_Click"/>
            <Button Content="Cancel"
                    Width="75"
                    Margin="20,0,0,0"
                    Click="CancelButton_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
