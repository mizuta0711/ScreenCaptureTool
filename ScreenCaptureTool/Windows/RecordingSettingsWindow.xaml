<Window
    x:Class="ScreenCaptureTool.Windows.RecordingSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ScreenCaptureTool.Windows.Controls"
    Title="撮影設定"
    Width="460"
    Height="520"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10" Orientation="Vertical">
        <!--  設定名称  -->
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Width="36"
                Height="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="名称" />
            <TextBox
                x:Name="textBoxName"
                Width="395"
                Height="16"
                VerticalAlignment="Top"
                Text=""
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  説明  -->
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
            <TextBlock
                Width="36"
                Height="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="説明" />
            <TextBox
                x:Name="textBoxDescription"
                Width="395"
                Height="16"
                VerticalAlignment="Top"
                Text=""
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  撮影方法  -->
        <TextBlock
            Width="53"
            Height="16"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="撮影方法" />

        <!--  撮影方法：ウィンドウ全体  -->
        <StackPanel
            Height="40"
            Margin="20,5,10,0"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    x:Name="radioButtonWindow"
                    Height="14"
                    HorizontalAlignment="Left"
                    Checked="RefreshUIControls"
                    Content="ウィンドウ全体"
                    GroupName="RecordingType" />
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Text="※ウィンドウタイトルを指定してウィンドウ全体を撮影します" />
            </StackPanel>
            <StackPanel
                x:Name="RecordingTypeWindowPanel"
                Margin="20,10,0,0"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <!--  ウィンドウタイトル  -->
                <TextBlock
                    x:Name="labelWindowTitle"
                    Width="82"
                    Height="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="ウィンドウタイトル" />
                <TextBox
                    x:Name="textBoxWindowTitle"
                    Width="300"
                    Height="16"
                    VerticalAlignment="Center"
                    Text=""
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!--  撮影方法：画面の一部  -->
        <StackPanel
            Height="120"
            Margin="20,10,10,0"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    x:Name="radioButtonRectangle"
                    Height="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Checked="RefreshUIControls"
                    Content="画面の一部"
                    GroupName="RecordingType" />
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Text="※画面内の一部を撮影します。位置、サイズを固定しない場合は撮影時に指定します" />
            </StackPanel>
            <StackPanel
                x:Name="RecordingTypeRectanglePanel"
                Margin="20,10,0,0"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <StackPanel
                    Width="400"
                    Height="85"
                    Orientation="Vertical">
                    <!--  位置  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            x:Name="labelWindowRectPos"
                            Width="50"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Text="位置" />
                        <CheckBox
                            x:Name="checkBoxFixedPos"
                            Width="80"
                            Height="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="RefreshUIControls"
                            Content="固定" />
                        <StackPanel x:Name="recordingPositionPanel" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="labelWindowPosX"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    Text="X座標：" />
                                <controls:NumericTextBox
                                    x:Name="textBoxWindowPosX"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Right"
                                    MaxLength="5"
                                    Text="" />
                            </StackPanel>
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="labelWindowPosY"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    Text="Y座標：" />
                                <controls:NumericTextBox
                                    x:Name="textBoxWindowPosY"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Right"
                                    MaxLength="5"
                                    Text="" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!--  サイズ  -->
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock
                            x:Name="labelWindowRectSize"
                            Width="50"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Text="サイズ" />
                        <CheckBox
                            x:Name="checkBoxFixedSize"
                            Width="80"
                            Height="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="RefreshUIControls"
                            Content="固定" />
                        <StackPanel x:Name="recordingSizePanel" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="labelWindowWidth"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    Text="幅：" />
                                <controls:NumericTextBox
                                    x:Name="textBoxWindowWidth"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Right"
                                    MaxLength="5"
                                    Text="" />
                            </StackPanel>
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="labelWindowHeight"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    Text="高さ：" />
                                <controls:NumericTextBox
                                    x:Name="textBoxWindowHeight"
                                    Width="50"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Right"
                                    MaxLength="5"
                                    Text="" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  画像加工  -->
        <StackPanel
            Height="90"
            Margin="0,10,0,0"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <TextBlock
                Width="70"
                Height="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="画像加工"
                TextWrapping="Wrap" />
            <!--  画像加工：縁カット  -->
            <StackPanel Width="150" Orientation="Vertical">
                <CheckBox
                    x:Name="checkBoxTrimEdge"
                    Height="20"
                    HorizontalAlignment="Left"
                    Click="RefreshUIControls"
                    Content="縁トリミング" />
                <StackPanel
                    x:Name="trimEdgePanel"
                    Margin="20,10,0,0"
                    Orientation="Vertical">
                    <controls:NumericTextBox
                        x:Name="textBoxTrimTop"
                        Width="50"
                        Height="16"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Right"
                        MaxLength="5"
                        Text="0" />
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <controls:NumericTextBox
                            x:Name="textBoxTrimLeft"
                            Width="50"
                            Height="16"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Right"
                            MaxLength="5"
                            Text="0" />
                        <controls:NumericTextBox
                            x:Name="textBoxTrimRight"
                            Width="50"
                            Height="16"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Right"
                            MaxLength="5"
                            Text="0" />
                    </StackPanel>
                    <controls:NumericTextBox
                        x:Name="textBoxTrimBottom"
                        Width="50"
                        Height="16"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Right"
                        MaxLength="5"
                        Text="0" />
                </StackPanel>
            </StackPanel>
            <!--  画像加工：リサイズ  -->
            <StackPanel Orientation="Vertical">
                <CheckBox
                    x:Name="checkBoxResize"
                    Height="20"
                    HorizontalAlignment="Left"
                    Click="RefreshUIControls"
                    Content="リサイズ" />
                <StackPanel
                    x:Name="resizePanel"
                    Margin="10,10,0,0"
                    Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            x:Name="labelResizeWidth"
                            Width="50"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Text="幅：" />
                        <controls:NumericTextBox
                            x:Name="textBoxResizeWidth"
                            Width="50"
                            Height="16"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Right"
                            MaxLength="5"
                            Text="" />
                        <TextBlock Text="px" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock
                            x:Name="labelResizeHeight"
                            Width="50"
                            Height="16"
                            HorizontalAlignment="Left"
                            Text="高さ：" />
                        <controls:NumericTextBox
                            x:Name="textBoxResizeHeight"
                            Width="50"
                            Height="16"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Right"
                            MaxLength="5"
                            Text="" />
                        <TextBlock Text="px" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="9"
                        Text="※アスペクト比が異なる場合も強制的にリサイズされます" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  保存方法  -->
        <StackPanel
            Height="45"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <TextBlock
                Width="70"
                Height="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="保存方法" />
            <StackPanel Width="150" Orientation="Vertical">
                <RadioButton
                    x:Name="radioButtonSaveClipboard"
                    Width="150"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="クリップボード"
                    GroupName="SaveTo"
                    Checked="RefreshUIControls" />
                <RadioButton
                    x:Name="radioButtonSaveBMP"
                    Width="150"
                    Height="20"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="ファイル(BMP形式)"
                    GroupName="SaveTo"
                    Checked="RefreshUIControls" />
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <RadioButton
                    x:Name="radioButtonSavePNG"
                    Width="150"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="ファイル(PNG形式)"
                    GroupName="SaveTo"
                    Checked="RefreshUIControls" />
                <RadioButton
                    x:Name="radioButtonSaveJPEG"
                    Width="150"
                    Height="20"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="ファイル(JPEG形式)"
                    GroupName="SaveTo"
                    Checked="RefreshUIControls" />
            </StackPanel>
        </StackPanel>
        <StackPanel
            Margin="70,5,0,0"
            Orientation="Horizontal">
            <CheckBox
                x:Name="checkBoxConfirmOverrideFile"
                Height="20"
                HorizontalAlignment="Left"
                Content="ファイルへの保存時に、上書き確認ダイアログを表示する" />
        </StackPanel>

        <!--  OK/キャンセルボタン  -->
        <StackPanel
            Height="25"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                Width="75"
                Margin="0,0,20,0"
                Click="OkButton_Click"
                Content="OK" />
            <Button
                Width="75"
                Margin="20,0,0,0"
                Click="CancelButton_Click"
                Content="キャンセル" />
        </StackPanel>
    </StackPanel>
</Window>